/**
 * @param {number[]} nums
 * @return {number[]}
 */
var majorityElement = function (nums) {
    let countMap = {}
    for (let i = 0; i < nums.length; i++) {
        if (countMap[nums[i]]) {
            countMap[nums[i]]++
        } else {
            countMap[nums[i]] = 1
        }
    }

    let n = nums.length;
    let result = [];

    for (let key in countMap) {
        if (countMap[key] > Math.floor(n / 3)) {
            result.push(Number(key));
        }
    }
    return result;
};
